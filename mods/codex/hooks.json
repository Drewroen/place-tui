{
  "description": "place: play on the shared map while Codex works",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.codex/hooks/place-pane.sh start" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.codex/hooks/place-pane.sh stop" }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.codex/hooks/place-pane.sh close" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash ~/.codex/hooks/place-pane.sh close" }
        ]
      }
    ]
  }
}
